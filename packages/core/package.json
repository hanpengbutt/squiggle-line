      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@squiggle-line/eslint-config": "workspace:*",
    "@squiggle-line/typescript-config": "workspace:*"
  },
  "publishConfig": {
