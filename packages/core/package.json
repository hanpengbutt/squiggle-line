{
  "name": "@squiggle-line/core",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanpengbutt/squiggle-line.git"
  },
  "description": "Zero-dependency engine for converting SVG paths into hand-drawn wobbly strokes",
  "keywords": [
    "svg",
    "doodle",
