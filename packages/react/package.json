{
  "name": "@squiggle-line/react",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanpengbutt/squiggle-line.git"
  },
  "description": "React bindings for @squiggle-line/core — WobblyBox, WobblyShape components and hooks",
  "keywords": [
    "react",
    "svg",
    "doodle",
    "hand-drawn",
    "squiggle",
    "wiggle"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
