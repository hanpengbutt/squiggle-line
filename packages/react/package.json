    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@squiggle-line/eslint-config": "workspace:*",
    "@squiggle-line/typescript-config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "dependencies": {
    "@squiggle-line/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
